# Frontend + JSON backend, with no external dependencies.
make site = app()
func hello(request)
    return {"message": "Hello from RonLang", "version": "0.3.0"}
end
func echo(request)
    return request["body"]
end
get(site, "/api/hello", hello)
post(site, "/api/echo", echo)
make content = heading("My first website") + paragraph("Frontend and backend in RonLang")
make content = content + button("Call API", "/api/hello", "result") + output("result")
get(site, "/", page("RonLang Web", content))
serve(site, 8000)
